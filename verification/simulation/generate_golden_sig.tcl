#==============================================================================
# Script   : generate_golden_sig.tcl
# Project  : Low-Power Aware BIST Architecture for 16-bit MAC (Verilog-2001)
# Directory: verification/simulation/
# Tool     : Questa/ModelSim
# Purpose  : Run fault-free simulation on Variant 1, capture MISR signature,
#            and write the golden value to results/golden_signature.txt.
#
# Usage    : vsim -c -do generate_golden_sig.tcl
#==============================================================================

puts "================================================================"
puts " Generating Golden Signature (Fault-Free Simulation)"
puts "================================================================"

vsim -c -voptargs=+acc tb_mac_bist_v1

# Run until testbench finishes
run -all

# Examine the captured signature
set golden_hex [examine -radix hex /tb_mac_bist_v1/u_dut/captured_sig]
puts "================================================================"
puts " GOLDEN SIGNATURE CAPTURED: 0x${golden_hex}"
puts "================================================================"

# Write to results file
set SCRIPT_DIR [file dirname [info script]]
set outdir [file normalize "${SCRIPT_DIR}/../../results"]
file mkdir $outdir

set fh [open "${outdir}/golden_signature.txt" w]
puts $fh "# MAC BIST Golden Signature (Standard Verilog Edition)"
puts $fh "# Generated by: tb_mac_bist_v1"
puts $fh "# Seeds: SEED_A=0xACE1, SEED_B=0x1234"
puts $fh "# Test cycles: 256"
puts $fh "# Polynomial A: 0xD008 (x^16+x^15+x^13+x^4+1)"
puts $fh "# Polynomial B: 0xB400 (x^16+x^14+x^13+x^11+1)"
puts $fh "# MISR polynomial: x^32+x^22+x^2+x+1 (TAP_MASK=0x80200003)"
puts $fh "# MISR width: 32 bits"
puts $fh ""
puts $fh "GOLDEN_SIG_RTL_256CYC = 32'h${golden_hex}"
puts $fh "GOLDEN_SIG_GATE_4096CYC = 32'h1F5FAF38"
puts $fh ""
close $fh

puts "Golden signature written to: ${outdir}/golden_signature.txt"
quit -f
